NODE_ENV=development
DATABASE_URL=mongodb://localhost:27017/synapse-hms
# Optional: MongoDB Atlas URL for sync jobs (or use MONGO_ATLAS_URI)
ATLAS_DATABASE_URL=
JWT_ACCESS_SECRET=replace-with-a-local-secret
JWT_REFRESH_SECRET=replace-with-a-local-secret
JWT_FORGOT_SECRET=replace-with-a-local-secret
# Comma-separated frontend origins; production must set this explicitly
CORS_ORIGINS=http://localhost:3000
# Required in production for local lab instrument integrations
LIS_API_KEY=
# Optional MongoDB user IDs for the in-house lab, pharmacy, and reception
IN_HOUSE_LAB_ID=
IN_HOUSE_PHARMACY_ID=
IN_HOUSE_RECEPTION=
