# Copy this file to backend/.env and replace the example values.
# Keep real database credentials and JWT secrets out of version control.

DATABASE_URL=mongodb://127.0.0.1:27017/hms

# Set three different long random secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_FORGOT_SECRET=replace-with-a-long-random-password-reset-secret

# Use the 24-character MongoDB ObjectIds of existing in-house accounts.
# IN_HOUSE_LAB_ID may be empty only when exactly one Lab account exists.
IN_HOUSE_LAB_ID=
IN_HOUSE_PHARMACY_ID=

# Optional comma-separated browser origins. The backend listens on port 3001.
CORS_ORIGINS=http://localhost:3000
