# Database connection string (required)
DATABASE_URL=

# Use separate random secrets of at least 32 characters each (required)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FORGOT_PASSWORD_SECRET=

# IDs of the in-house users for this database
IN_HOUSE_LAB_ID=
IN_HOUSE_PHARMACY_ID=

# Shared secret for laboratory instrument ingest (header: x-lis-api-key)
LIS_API_KEY=

# The API currently listens on port 3001 (the value is fixed in src/main.ts)
PORT=3001
